{
  "name": "drafty3d",
  "version": "0.1.0",
  "private": true,
  "description": "Portal de diseño y gestión de archivos para SolidCraft, SculptGL y SVG-Edit.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup:solidcraft": "node scripts/solidcraft.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/dev.mjs --static",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "build:learn": "node scripts/learn.mjs",
    "learn:examples": "node learn/pipeline/build-examples.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@supabase/supabase-js": "2.119.0",
    "botid": "1.5.11",
    "fflate": "0.8.3",
    "file-saver": "2.0.5",
    "gl-matrix": "3.4.4",
    "gsap": "3.15.1",
    "hammerjs": "2.0.8",
    "svgedit": "7.4.2",
    "three": "0.186.1",
    "yagui": "2.0.2"
  },
  "devDependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/cli": "8.6.2",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.0",
    "draco3dgltf": "1.5.9",
    "vite": "8.3.4"
  }
}
