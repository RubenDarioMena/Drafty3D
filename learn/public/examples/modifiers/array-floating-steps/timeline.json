{
  "blenderVersion": "5.3.0",
  "module": "modifiers",
  "example": "array-floating-steps",
  "mode": "your-turn",
  "title": "Your turn: floating steps",
  "object": "Slab",
  "initial": {
    "panel": "panel.properties.object",
    "camera": {
      "position": [
        1,
        -2.3,
        1.1
      ],
      "target": [
        0.35,
        0,
        0.15
      ],
      "fov": 30
    },
    "text": "A thin slab. Stack copies with a gap between them, like steps fixed to a wall.",
    "mesh": "step-00.glb"
  },
  "steps": [
    {
      "id": "panel.properties.modifier",
      "action": "select_panel",
      "value": null,
      "value_type": null,
      "shortcut": {
        "keys": [
          "Ctrl",
          "Tab"
        ],
        "context": "Properties editor · next tab"
      },
      "duration": 1.4,
      "autoAdvance": true,
      "text": "Open the Modifier Properties tab.",
      "help": "The wrench icon, right below the orange Object square.",
      "camera": {
        "position": [
          1,
          -2.3,
          1.1
        ],
        "target": [
          0.35,
          0,
          0.15
        ],
        "fov": 30
      },
      "mesh": null
    },
    {
      "id": "modifier.array.add",
      "action": "add_modifier",
      "value": "Array",
      "value_type": "string",
      "modifier": "ARRAY",
      "shortcut": {
        "keys": [
          "Shift",
          "A"
        ],
        "context": "Properties editor · Modifiers tab"
      },
      "duration": 2.8,
      "autoAdvance": false,
      "text": "Repeat the slab: add an Array modifier.",
      "help": "Add Modifier → Generate → Array.",
      "camera": {
        "position": [
          1,
          -2.3,
          1.1
        ],
        "target": [
          0.35,
          0,
          0.15
        ],
        "fov": 30
      },
      "mesh": "step-02.glb"
    },
    {
      "id": "modifier.array.factor_z",
      "action": "set_value",
      "value": 2.5,
      "value_type": "number",
      "modifier": "ARRAY",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Factor Z to 2.5: each copy rises two and a half slab heights, leaving a gap.",
      "help": "Factor X, Y, Z are in the Relative Offset subpanel. Z is the third.",
      "step": 0.1,
      "camera": {
        "position": [
          1,
          -2.3,
          1.1
        ],
        "target": [
          0.35,
          0,
          0.15
        ],
        "fov": 30
      },
      "mesh": "step-03.glb"
    },
    {
      "id": "modifier.array.count",
      "action": "set_value",
      "value": 5,
      "value_type": "number",
      "modifier": "ARRAY",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Count to 5.",
      "help": "Count is right below Fit Type.",
      "step": 1,
      "camera": {
        "position": [
          2.1,
          -3.3,
          1.95
        ],
        "target": [
          1.05,
          0,
          0.65
        ],
        "fov": 30
      },
      "mesh": "step-04.glb"
    }
  ],
  "variantOf": "array-stairs",
  "outro": "Floating steps finished: one Array, with a bigger Z offset than the slab is tall."
}
