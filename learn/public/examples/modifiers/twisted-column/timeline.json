      "target": [
        0,
        0,
        0.7
      ],
      "fov": 30
    },
    "text": "A plain square column becomes a twisted one. Two modifiers: Bevel softens the corners, Simple Deform twists the whole shape.",
    "mesh": "step-00.glb"
  },
  "steps": [
    {
      "id": "panel.properties.modifier",
      "action": "select_panel",
      "value": null,
      "value_type": null,
      "shortcut": {
