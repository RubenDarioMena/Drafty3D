          "Ctrl",
          "Tab"
        ],
        "context": "Properties editor · next tab"
      },
      "duration": 1.4,
      "autoAdvance": true,
      "text": "Open the Modifier Properties tab, the wrench.",
      "help": null,
      "camera": {
        "position": [
          2.25,
          -2.75,
          1.4
        ],
        "target": [
          0,
          0,
          0.7
        ],
        "fov": 30
      },
      "mesh": null
    },
    {
      "id": "modifier.bevel.add",
      "action": "add_modifier",
      "value": "Bevel",
      "value_type": "string",
      "modifier": "BEVEL",
      "shortcut": {
        "keys": [
          "Shift",
          "A"
        ],
        "context": "Properties editor · Modifiers tab"
      },
      "duration": 2.8,
      "autoAdvance": false,
      "text": "Add Modifier → Generate → Bevel. Only the four corner edges are sharp enough to be beveled.",
      "help": null,
      "camera": {
        "position": [
          2.25,
          -2.75,
          1.4
        ],
        "target": [
          0,
          0,
          0.7
        ],
        "fov": 30
      },
      "mesh": "step-02.glb"
    },
    {
      "id": "modifier.bevel.amount",
      "action": "set_value",
      "value": 0.04,
      "value_type": "number",
      "modifier": "BEVEL",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Amount to 0.04 m: a soft corner, not a cut-off one.",
      "help": null,
      "step": 0.01,
      "camera": {
        "position": [
          1,
          -1.3,
          1.75
        ],
        "target": [
          0,
          0,
          1.2
        ],
        "fov": 30
      },
      "mesh": "step-03.glb"
    },
    {
      "id": "modifier.bevel.segments",
      "action": "set_value",
      "value": 3,
      "value_type": "number",
      "modifier": "BEVEL",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Raise Segments to 3 to round each corner.",
      "help": null,
      "step": 1,
      "camera": {
        "position": [
          1,
          -1.3,
          1.75
        ],
        "target": [
          0,
          0,
          1.2
        ],
        "fov": 30
      },
      "mesh": "step-04.glb"
    },
    {
      "id": "modifier.simple_deform.add",
      "action": "add_modifier",
      "value": "Simple Deform",
      "value_type": "string",
      "modifier": "SIMPLE_DEFORM",
      "shortcut": {
        "keys": [
          "Shift",
          "A"
        ],
        "context": "Properties editor · Modifiers tab"
      },
      "duration": 2.8,
      "autoAdvance": false,
      "text": "Add Modifier → Deform → Simple Deform. It starts as a 45° Twist around X, so the column folds sideways.",
