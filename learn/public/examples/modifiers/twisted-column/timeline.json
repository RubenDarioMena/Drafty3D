      "camera": {
        "position": [
          2.25,
          -2.75,
          1.4
        ],
        "target": [
          0,
          0,
          0.7
        ],
        "fov": 30
      },
      "mesh": "step-05.glb"
    },
    {
      "id": "modifier.simple_deform.axis",
      "action": "set_value",
      "value": "Z",
      "value_type": "enum",
      "modifier": "SIMPLE_DEFORM",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Axis to Z, the column's length. Now it twists around itself; the rings along it keep the twist smooth.",
      "help": null,
      "camera": {
        "position": [
          2.25,
          -2.75,
          1.4
        ],
        "target": [
          0,
          0,
          0.7
        ],
        "fov": 30
      },
      "mesh": "step-06.glb"
    },
    {
      "id": "modifier.simple_deform.angle",
      "action": "set_value",
      "value": 90,
      "value_type": "number",
      "modifier": "SIMPLE_DEFORM",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Angle to 90°: the top turns a quarter turn relative to the base.",
      "help": null,
      "step": 5,
      "camera": {
        "position": [
          2.25,
          -2.75,
          1.4
        ],
        "target": [
          0,
          0,
          0.7
        ],
        "fov": 30
      },
      "mesh": "step-07.glb"
    }
  ],
  "outro": "Done: Bevel first, then Simple Deform, so the rounded corners twist too. Now twist a candle yourself."
}
