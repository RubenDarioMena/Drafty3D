{
  "blenderVersion": "5.3.0",
  "module": "modifiers",
  "example": "array-stairs",
  "mode": "watch",
  "title": "Staircase from one step",
  "object": "Step",
  "initial": {
    "panel": "panel.properties.object",
    "camera": {
      "position": [
        1.1,
        -2.6,
        1.3
      ],
      "target": [
        0.35,
        0,
        0.2
      ],
      "fov": 30
    },
    "text": "One step, six steps. Array repeats an object; Relative Offset moves each copy by the object's own size.",
    "mesh": "step-00.glb"
  },
  "steps": [
    {
      "id": "panel.properties.modifier",
      "action": "select_panel",
      "value": null,
      "value_type": null,
      "shortcut": {
        "keys": [
          "Ctrl",
          "Tab"
        ],
        "context": "Properties editor · next tab"
      },
      "duration": 1.4,
      "autoAdvance": true,
      "text": "Open the Modifier Properties tab, the wrench.",
      "help": null,
      "camera": {
        "position": [
          1.1,
          -2.6,
          1.3
        ],
        "target": [
          0.35,
          0,
          0.2
        ],
        "fov": 30
      },
      "mesh": null
    },
    {
      "id": "modifier.array.add",
      "action": "add_modifier",
      "value": "Array",
      "value_type": "string",
      "modifier": "ARRAY",
      "shortcut": {
        "keys": [
          "Shift",
          "A"
        ],
        "context": "Properties editor · Modifiers tab"
      },
      "duration": 2.8,
      "autoAdvance": false,
      "text": "Add Modifier → Generate → Array. Two copies, the second one step-depth further along X: Factor X is 1.",
      "help": null,
      "camera": {
        "position": [
          1.1,
          -2.6,
          1.3
        ],
        "target": [
          0.35,
          0,
          0.2
        ],
        "fov": 30
      },
      "mesh": "step-02.glb"
    },
    {
      "id": "modifier.array.factor_z",
      "action": "set_value",
      "value": 1,
      "value_type": "number",
      "modifier": "ARRAY",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Factor Z to 1: each copy also rises one step height. Now it climbs.",
      "help": null,
      "step": 0.1,
      "camera": {
        "position": [
          1.1,
          -2.6,
          1.3
        ],
        "target": [
          0.35,
          0,
          0.2
        ],
        "fov": 30
      },
      "mesh": "step-03.glb"
    },
    {
      "id": "modifier.array.count",
      "action": "set_value",
      "value": 6,
      "value_type": "number",
      "modifier": "ARRAY",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Raise Count to 6. Same offset, six steps.",
      "help": null,
      "step": 1,
      "camera": {
        "position": [
          0.2,
          -3.6,
          1.6
        ],
        "target": [
          0.9,
          0,
          0.58
        ],
        "fov": 30
      },
      "mesh": "step-04.glb"
    }
  ],
  "outro": "Done: Count says how many, the offset says where the next one goes. Now make floating steps yourself."
}
