{
  "blenderVersion": "5.3.0",
  "module": "modifiers",
  "example": "mirror-table",
  "mode": "watch",
  "title": "Table from one corner",
  "object": "Table",
  "initial": {
    "panel": "panel.properties.object",
    "camera": {
      "position": [
        2,
        -2.45,
        1.75
      ],
      "target": [
        0,
        0,
        0.38
      ],
      "fov": 30
    },
    "text": "Only one corner of this table is modeled. Mirror copies it across X and Y; whatever you change in the corner, the other three follow.",
    "mesh": "step-00.glb"
  },
  "steps": [
    {
      "id": "panel.properties.modifier",
      "action": "select_panel",
      "value": null,
      "value_type": null,
      "shortcut": {
        "keys": [
          "Ctrl",
          "Tab"
        ],
        "context": "Properties editor · next tab"
      },
      "duration": 1.4,
      "autoAdvance": true,
      "text": "Open the Modifier Properties tab, the wrench.",
      "help": null,
      "camera": {
        "position": [
          2,
          -2.45,
          1.75
        ],
        "target": [
          0,
          0,
          0.38
        ],
        "fov": 30
      },
      "mesh": null
    },
    {
      "id": "modifier.mirror.add",
      "action": "add_modifier",
      "value": "Mirror",
      "value_type": "string",
      "modifier": "MIRROR",
      "shortcut": {
        "keys": [
          "Shift",
          "A"
        ],
        "context": "Properties editor · Modifiers tab"
      },
      "duration": 2.8,
      "autoAdvance": false,
      "text": "Add Modifier → Generate → Mirror. Axis X is on: the corner is copied across the red X axis, so you see two legs.",
      "help": null,
      "camera": {
        "position": [
          2,
          -2.45,
          1.75
        ],
        "target": [
          0,
          0,
          0.38
        ],
        "fov": 30
      },
      "mesh": "step-02.glb"
    },
    {
      "id": "modifier.mirror.axis_y",
      "action": "set_value",
      "value": true,
      "value_type": "bool",
      "modifier": "MIRROR",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Turn on Axis Y too. Each half is copied across Y: four legs, one whole top. Merge joins the copies along the seams.",
      "help": null,
      "camera": {
        "position": [
          2,
          -2.45,
          1.75
        ],
        "target": [
          0,
          0,
          0.38
        ],
        "fov": 30
      },
      "mesh": "step-03.glb"
    },
    {
      "id": "modifier.bevel.add",
      "action": "add_modifier",
      "value": "Bevel",
      "value_type": "string",
      "modifier": "BEVEL",
      "shortcut": {
        "keys": [
          "Shift",
          "A"
        ],
        "context": "Properties editor · Modifiers tab"
      },
      "duration": 2.8,
      "autoAdvance": false,
      "text": "Add a Bevel below Mirror. It rounds the whole mirrored table, and its 0.1 m default is far too big for a 6 cm top.",
      "help": null,
      "camera": {
        "position": [
          1.3,
          -1.35,
          1.2
        ],
        "target": [
          0.45,
          -0.28,
          0.6
        ],
        "fov": 30
      },
      "mesh": "step-04.glb"
    },
    {
      "id": "modifier.bevel.amount",
      "action": "set_value",
      "value": 0.02,
      "value_type": "number",
      "modifier": "BEVEL",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Set Amount to 0.02 m: a soft edge on the top and the legs.",
      "help": null,
      "step": 0.01,
      "camera": {
        "position": [
          1.3,
          -1.35,
          1.2
        ],
        "target": [
          0.45,
          -0.28,
          0.6
        ],
        "fov": 30
      },
      "mesh": "step-05.glb"
    },
    {
      "id": "modifier.bevel.segments",
      "action": "set_value",
      "value": 3,
      "value_type": "number",
      "modifier": "BEVEL",
      "shortcut": null,
      "duration": 2.2,
      "autoAdvance": false,
      "text": "Raise Segments to 3 to round it.",
      "help": null,
      "step": 1,
      "camera": {
        "position": [
          1.3,
          -1.35,
          1.2
        ],
        "target": [
          0.45,
          -0.28,
          0.6
        ],
        "fov": 30
      },
      "mesh": "step-06.glb"
    }
  ],
  "outro": "Done: model a quarter, Mirror the rest, Bevel after Mirror so every copy gets the same edge. Now build a bench yourself."
}
