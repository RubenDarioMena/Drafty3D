{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/solidcraft/app/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/solidcraft/app/build.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
